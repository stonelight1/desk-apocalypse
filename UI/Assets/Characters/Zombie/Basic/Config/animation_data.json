{
  "meta": {
    "name": "Zombie Basic",
    "canvas_size": [
      512,
      512
    ],
    "orientation": "left",
    "format": "single_png_frames",
    "pivot_note": "stand and motion frames aligned near common foot baseline; death frames aligned to a common root line"
  },
  "animations": {
    "idle": {
      "dir": "Animations/Idle",
      "prefix": "idle_",
      "frames": 4,
      "fps": 4,
      "loop": true
    },
    "walk": {
      "dir": "Animations/Walk",
      "prefix": "walk_",
      "frames": 6,
      "fps": 8,
      "loop": true
    },
    "attack": {
      "dir": "Animations/Attack",
      "prefix": "attack_",
      "frames": 5,
      "fps": 10,
      "loop": false
    },
    "hit": {
      "dir": "Animations/Hit",
      "prefix": "hit_",
      "frames": 3,
      "fps": 12,
      "loop": false
    },
    "death": {
      "dir": "Animations/Death",
      "prefix": "death_",
      "frames": 6,
      "fps": 8,
      "loop": false
    }
  }
}